<mxfile host="app.diagrams.net"><diagram name="System Context" id="system-context"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Collaborative Trip Planning System" style="text;html=0;align=center;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1520" height="60" /></mxCell><mxCell id="owner" value="Trip organizer&#10;[Person]&#10;Creates trips and invites&#10;travel companions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fb;fontColor=#244b77;strokeColor=#a5b2c2;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="170" width="300" height="175" /></mxCell><mxCell id="member" value="Trip participant&#10;[Person]&#10;Joins trips and contributes&#10;to shared planning" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fb;fontColor=#244b77;strokeColor=#a5b2c2;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="660" width="300" height="175" /></mxCell><mxCell id="system" value="Collaborative Trip Planning&#10;[Software System]&#10;Android / iOS / web&#10;with shared backend&#10;&#10;Trips, route generation, budget,&#10;map, editing and voting" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#244b77;fontColor=white;strokeColor=#a5b2c2;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="340" width="400" height="300" /></mxCell><mxCell id="ai" value="AI service&#10;[External System]&#10;Generates initial route drafts&#10;with explicit confirmation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f2f5;fontColor=#374151;strokeColor=#a5b2c2;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="170" width="300" height="175" /></mxCell><mxCell id="maps" value="Maps and places service&#10;[External System]&#10;Provides map, place and&#10;routing information" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0f2f5;fontColor=#374151;strokeColor=#a5b2c2;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="660" width="300" height="175" /></mxCell><mxCell id="edge0" value="" source="owner" target="system" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=block;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="475" y="257" /><mxPoint x="475" y="420" /></Array></mxGeometry></mxCell><mxCell id="label0" value="Creates trips; manages invitations&#10;and shared itinerary" style="text;html=0;whiteSpace=wrap;fillColor=#ffffff;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="305" width="225" height="85" /></mxCell><mxCell id="edge1" value="" source="member" target="system" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=block;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="475" y="747" /><mxPoint x="475" y="560" /></Array></mxGeometry></mxCell><mxCell id="label1" value="Views/edits shared plans;&#10;votes and checks planned budget" style="text;html=0;whiteSpace=wrap;fillColor=#ffffff;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="585" width="240" height="90" /></mxCell><mxCell id="edge2" value="" source="system" target="ai" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=block;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1125" y="420" /><mxPoint x="1125" y="257" /></Array></mxGeometry></mxCell><mxCell id="label2" value="Sends preferences and constraints;&#10;receives proposed plans" style="text;html=0;whiteSpace=wrap;fillColor=#ffffff;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1005" y="305" width="240" height="85" /></mxCell><mxCell id="edge3" value="" source="system" target="maps" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=block;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1125" y="560" /><mxPoint x="1125" y="747" /></Array></mxGeometry></mxCell><mxCell id="label3" value="Requests map and place data;&#10;receives locations and routes" style="text;html=0;whiteSpace=wrap;fillColor=#ffffff;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1005" y="585" width="240" height="90" /></mxCell><mxCell id="note" value="MVP includes clients, Supabase backend, database and identity. Android/iOS/web retained; provider details pending.&#10;Chat/comments/feed, conversational AI, actual expenses, weather/events, offline and booking are deferred." style="text;html=0;whiteSpace=wrap;align=center;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="890" width="1460" height="75" /></mxCell></root></mxGraphModel></diagram></mxfile>