<mxfile host="app.diagrams.net"><diagram name="Backend Components" id="backend-components"><mxGraphModel page="1" pageWidth="2000" pageHeight="1480"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Component Diagram — Backend and Database" style="text;html=0;fontSize=36;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1940" height="70" /></mxCell><mxCell id="boundary" value="" style="rounded=1;fillColor=#f5f8fc;strokeColor=#96acc6;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="110" width="1160" height="1240" /></mxCell><mxCell id="boundary-title" value="Shared backend — proposed Supabase platform" style="text;html=0;fontSize=23;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="630" y="120" width="1100" height="50" /></mxCell><mxCell id="edge0" source="clients" target="auth" edge="1" parent="1" style="edgeStyle=none;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="470" y="660" /><mxPoint x="470" y="270" /></Array></mxGeometry></mxCell><mxCell id="edge1" source="clients" target="api" edge="1" parent="1" style="edgeStyle=none;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="530" y="660" /><mxPoint x="530" y="560" /></Array></mxGeometry></mxCell><mxCell id="edge2" source="clients" target="commands" edge="1" parent="1" style="edgeStyle=none;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="530" y="660" /><mxPoint x="530" y="900" /></Array></mxGeometry></mxCell><mxCell id="edge3" source="realtime" target="clients" edge="1" parent="1" style="edgeStyle=none;endArrow=block;strokeColor=#66758a;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="470" y="1220" /><mxPoint x="470" y="660" /></Array></mxGeometry></mxCell><mxCell id="edge4" sourc